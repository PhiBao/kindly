# ─────────────────────────────────────────────────────────────────────────────
# Kindly — environment
#
# The defaults run the whole product with no accounts at all: PayPal is
# simulated in-process and the writing falls back to templates.
# Copy to .env and change what you need.
# ─────────────────────────────────────────────────────────────────────────────

# ── server ───────────────────────────────────────────────────────────────────
KINDLY_PORT=8787
KINDLY_DATA_DIR=./data
# Public base URL used inside the letters Kindly writes (the client portal link)
KINDLY_PUBLIC_URL=http://localhost:8787
# Bearer token for the dashboard API. Empty = open (local demos only).
KINDLY_ADMIN_TOKEN=
# Signing secret for client portal links. Change it for any shared deployment.
KINDLY_PORTAL_SECRET=kindly-dev-portal-secret-change-me
# Seed the demo studio on boot when the database is empty.
KINDLY_SEED=1
# Run the autonomous pass (advance conversations, reconcile with PayPal).
KINDLY_SCHEDULER=1

# ── the person being paid ────────────────────────────────────────────────────
KINDLY_OWNER_NAME=Maya Rodriguez
KINDLY_OWNER_BUSINESS=Maya Rodriguez Studio
KINDLY_INVOICER_EMAIL=merchant@kindly.demo

# ── PayPal ───────────────────────────────────────────────────────────────────
# sim  = in-process simulator (default; no credentials, nothing leaves the box)
# live = real PayPal APIs. Use the sandbox until you are sure.
KINDLY_PAYPAL_MODE=sim
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the PayPal developer dashboard (required to verify deliveries)
PAYPAL_WEBHOOK_ID=
# Simulator webhook signing secret (dev only)
KINDLY_SIM_WEBHOOK_SECRET=kindly-sim-webhook-secret

# ── language model (optional) ────────────────────────────────────────────────
# Any OpenAI-compatible endpoint: OpenAI, OpenRouter, Azure, vLLM, Ollama…
# Without a key, Kindly writes from deterministic templates. Everything else —
# the policy engine, negotiation, settlement, attribution — is unaffected.
KINDLY_LLM_BASE_URL=https://api.openai.com/v1
KINDLY_LLM_API_KEY=
KINDLY_LLM_MODEL=gpt-4o-mini

# ── database (optional override) ─────────────────────────────────────────────
# DATABASE_URL=sqlite:./data/kindly.db?mode=rwc
