  "segments": [
    {
      "id": "s1_title",
      "text": "If you've ever freelanced, you know the worst part of an overdue invoice. It's the asking. You have to go back to someone you like and ask for money you already earned. Kindly does that part. It chases the client, negotiates the terms, and takes the payment through PayPal.",
      "scene": {
        "kind": "card",
        "template": "title-left"
      }
    },
    {
      "id": "s2_desk",
      "text": "Here's a studio's actual book. Eleven thousand five hundred fifty dollars still out. Three invoices past due. Nine hundred that already came in through PayPal. Before Kindly does anything, it has to work inside these limits. Two contacts a week. Never under seventy percent up front. No discounts without asking. Three instalments at most, inside forty-five days. You write them once. The agent can't go around them.",
      "scene": {
        "kind": "page",
        "src": "https://kindly-desk-web.vercel.app/",
        "zoom": 1.15,
        "wait_for": [
          "text=You do the work."
